map $http_x_forwarded_proto $laundry_https {
    default off;
    https on;
}

map $laundry_https $laundry_port {
    default 80;
    on 443;
}

server {
    listen 80 default_server;
    server_name _;
    return 444;
}

server {
    listen 80;
    server_name laundry.karuhundeveloper.com localhost 127.0.0.1;
    root ${DEPLOY_ROOT}/current/public;
    index index.php;
    charset utf-8;
    server_tokens off;
    client_max_body_size 30m;

    set_real_ip_from 172.30.99.1;
    real_ip_header CF-Connecting-IP;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ^~ /build/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options nosniff always;
    }

    location = /index.php {
        include fastcgi_params;
        fastcgi_pass app:9000;
        fastcgi_param SCRIPT_FILENAME $realpath_root/index.php;
        fastcgi_param DOCUMENT_ROOT $realpath_root;
        fastcgi_param HTTPS $laundry_https;
        fastcgi_param SERVER_PORT $laundry_port;
        fastcgi_hide_header X-Powered-By;
        fastcgi_read_timeout 65s;
        fastcgi_buffer_size 128k;
        fastcgi_buffers 16 64k;
        fastcgi_busy_buffers_size 128k;
    }

    location ~ \.php(?:/|$) {
        return 404;
    }

    location ~ /\.(?!well-known).* {
        deny all;
    }
}
